import { useState, useMemo } from "react";
import { useMutation } from "@tanstack/react-query";
import { useServerFn } from "@tanstack/react-start";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  ReferenceLine,
} from "recharts";
import { TooltipProvider } from "@/components/ui/tooltip";
import { Collapsible, CollapsibleContent, CollapsibleTrigger } from "@/components/ui/collapsible";
import { InfoTip } from "./InfoTip";
import { useIOLSession } from "@/lib/iol-context";

function fmtDate(d: string) {
  if (!d || d.length < 10) return d;
  return d.slice(8, 10) + "/" + d.slice(5, 7);
}
import { computePairAnalysis } from "@/lib/statarb.server";
import { SpreadChart } from "./SpreadChart";
import { ZScoreChart } from "./ZScoreChart";
import { PnLChart } from "./PnLChart";
import { TradesTable } from "./TradesTable";
import { TradingViewCompareWidget } from "./TradingViewCompareWidget";
import type { PairAnalysisResult, PairConfig, DataInterval } from "@/lib/statarb.types";
import { DEFAULT_PAIR_CONFIG, intervalLabel } from "@/lib/statarb.types";
import { SocialContentPanel } from "@/components/shared/SocialContentPanel";
import { detectCalculationAnomalies } from "@/lib/social/anomaly-detector";
import type { InvestorContentInput } from "@/lib/social/social-content-generator";

import type { SharedPairConfig } from "./StatArbTab";

interface PairsTradingProps {
  shared: SharedPairConfig;
  onUpdateShared: <K extends keyof SharedPairConfig>(k: K, v: SharedPairConfig[K]) => void;
  source: "yahoo" | "iol";
  onSourceChange: (s: "yahoo" | "iol") => void;
  iolMercado: string;
  onIolMercadoChange: (m: string) => void;
}

export function PairsTradingPanel({
  shared,
  onUpdateShared,
  source,
  onSourceChange,
  iolMercado,
  onIolMercadoChange,
}: PairsTradingProps) {
  const { accessToken } = useIOLSession();
  const [result, setResult] = useState<PairAnalysisResult | null>(null);
  const [error, setError] = useState("");
  const [tutorialOpen, setTutorialOpen] = useState(false);
  const [selectedTradeIdx, setSelectedTradeIdx] = useState<number | undefined>(undefined);
  const [validateOOS, setValidateOOS] = useState(false);

  const config: PairConfig = {
    ...DEFAULT_PAIR_CONFIG,
    asset1: shared.asset1,
    asset2: shared.asset2,
    period: shared.period,
    interval: shared.interval,
    window: shared.window,
    entryThresh: shared.entryThresh,
    stopThresh: shared.stopThresh,
    capitalPerPair: shared.capitalPerPair,
    txCost: shared.txCost,
    inSampleRatio: validateOOS ? 0.7 : undefined,
    // ─── Labadie ───
    executionAlgo: shared.executionAlgo,
    pValue: shared.pValue,
    marketImpactGamma: shared.marketImpactGamma,
    participationRate: shared.participationRate,
    volatility: 0.2, // default
  };
  const selectedTrade =
    selectedTradeIdx !== undefined ? result?.trades[selectedTradeIdx] ?? null : null;

  const fn = useServerFn(computePairAnalysis);

  const m = useMutation({
    mutationFn: async () => {
      setError("");
      setResult(null);
      setSelectedTradeIdx(undefined);
      const token = accessToken;
      if (source === "iol" && !token) {
        throw new Error(
          "Debés iniciar sesión en IOL desde el panel superior para usar esta fuente de datos.",
        );
      }
      const res = await fn({
        data: {
          asset1: shared.asset1.toUpperCase().trim(),
          asset2: shared.asset2.toUpperCase().trim(),
          period: shared.period,
          interval: shared.interval,
          window: shared.window,
          entryThresh: shared.entryThresh,
          stopThresh: shared.stopThresh,
          capitalPerPair: shared.capitalPerPair,
          txCost: shared.txCost,
          source,
          token,
          mercado: source === "iol" ? iolMercado : undefined,
          // ─── Labadie params ───
          executionAlgo: shared.executionAlgo,
          pValue: shared.pValue,
          marketImpactGamma: shared.marketImpactGamma,
          participationRate: shared.participationRate,
        },
      });
      setResult(res);
      return res;
    },
    onError: (e: Error) => setError(e.message),
  });

  return (
    <TooltipProvider>
      <div className="space-y-4">
        {/* Tutorial */}
        <Collapsible
          open={tutorialOpen}
          onOpenChange={setTutorialOpen}
          className="rounded-lg border border-border/40 bg-muted/5"
        >
          <CollapsibleTrigger className="flex w-full items-center justify-between px-4 py-2.5 font-mono text-xs text-foreground hover:bg-muted/10 transition-colors">
            <span>¿Cómo interpretar Pairs Trading?</span>
            <span className="text-muted-foreground">{tutorialOpen ? "▾" : "▸"}</span>
          </CollapsibleTrigger>
          <CollapsibleContent className="px-4 pb-3 pt-0">
            <div className="space-y-2 font-mono text-[10px] leading-relaxed text-muted-foreground">
              <p>
                <strong>Pairs Trading</strong> es una estrategia de mercado neutral que busca
                beneficiarse de la convergencia entre dos activos correlacionados. Se basa en la{" "}
                <strong>cointegración</strong>: si dos activos tienden a moverse juntos a largo
                plazo, cuando temporalmente se separan (divergencia), se abre una oportunidad de
                trading.
              </p>
              <div className="space-y-1 pt-1">
                <p className="text-foreground">Conceptos clave:</p>
                <ul className="list-disc pl-4 space-y-1">
                  <li>
                    <strong>Z-Score</strong> — mide cuántas desviaciones estándar está el spread de
                    su media histórica. Cuanto más lejos de 0, más oportunidad. Umbral típico: ±2σ.
                  </li>
                  <li>
                    <strong>Spread</strong> — diferencia entre los precios normalizados de ambos
                    activos. Debe ser estacionario (volver a la media) para que la estrategia
                    funcione.
                  </li>
                  <li>
                    <strong>Cointegración</strong> — si el test ADF arroja p &lt; 0.05, el spread
                    tiende a revertir a la media. Es la condición necesaria para pairs trading.
                  </li>
                  <li>
                    <strong>Señal LONG</strong> — Z-Score muy negativo (&lt; -a): comprar activo 1,
                    vender activo 2. <strong>Señal SHORT</strong> — Z-Score muy positivo (&gt; +a):
                    vender activo 1, comprar activo 2.
                  </li>
                  <li>
                    <strong>Sharpe ratio</strong> — retorno ajustado por riesgo. &gt; 1 es bueno,
                    &gt; 2 excelente. Mide si el retorno justifica el riesgo tomado.
                  </li>
                </ul>
              </div>
            </div>
          </CollapsibleContent>
        </Collapsible>

        {/* Config */}
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Ticker 1
            </label>
            <input
              value={config.asset1}
              onChange={(e) => onUpdateShared("asset1", e.target.value.toUpperCase())}
              className="w-full rounded border border-border/40 bg-background px-2 py-1.5 font-mono text-[11px] outline-none focus:border-primary/60"
            />
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Ticker 2
            </label>
            <input
              value={config.asset2}
              onChange={(e) => onUpdateShared("asset2", e.target.value.toUpperCase())}
              className="w-full rounded border border-border/40 bg-background px-2 py-1.5 font-mono text-[11px] outline-none focus:border-primary/60"
            />
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Período
            </label>
            <div className="flex gap-1">
              {(
                [
                  { v: 90, l: "3m" },
                  { v: 180, l: "6m" },
                  { v: 365, l: "1y" },
                  { v: 730, l: "2y" },
                ] as const
              ).map((p) => (
                <button
                  key={p.v}
                  onClick={() => onUpdateShared("period", p.v)}
                  className={`rounded border px-2 py-1 font-mono text-[11px] transition-colors ${config.period === p.v ? "border-primary/60 bg-primary/10 text-foreground" : "border-border/60 text-muted-foreground hover:text-foreground"}`}
                >
                  {p.l}
                </button>
              ))}
            </div>
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Ventana rolling
            </label>
            <input
              type="number"
              min={5}
              max={100}
              value={config.window}
              onChange={(e) =>
                onUpdateShared("window", Math.max(5, parseInt(e.target.value) || 20))
              }
              className="w-full rounded border border-border/40 bg-background px-2 py-1.5 font-mono text-[11px] outline-none focus:border-primary/60"
            />
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Intervalo
            </label>
            <select
              value={shared.interval}
              onChange={(e) => onUpdateShared("interval", e.target.value as DataInterval)}
              className="w-full rounded border border-border/40 bg-background px-2 py-1.5 font-mono text-[11px] outline-none focus:border-primary/60"
            >
              <option value="1d">Diario</option>
              <option value="1h">1 hora</option>
              <option value="30m">30 min</option>
              <option value="15m">15 min</option>
              <option value="5m">5 min</option>
            </select>
          </div>
        </div>

        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Umbral entrada (a): {config.entryThresh.toFixed(1)}σ
              <InfoTip>
                El Z-Score mide cuán lejos está el spread de su media histórica en desviaciones
                estándar. Cuando cruza ±aσ, se genera una señal de entrada. Valores típicos:
                1.5σ–2.5σ.
              </InfoTip>
            </label>
            <input
              type="range"
              min={0.5}
              max={3}
              step={0.1}
              value={config.entryThresh}
              onChange={(e) => onUpdateShared("entryThresh", parseFloat(e.target.value))}
              className="w-full accent-primary"
            />
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Stop-loss (b): {config.stopThresh.toFixed(1)}σ
              <InfoTip>
                Si el Z-Score supera ±bσ se cierra la posición para limitar pérdidas. Debe ser mayor
                que el umbral de entrada (a). Un stop más amplio da más espacio pero expone a mayor
                drawdown.
              </InfoTip>
            </label>
            <input
              type="range"
              min={1}
              max={4}
              step={0.1}
              value={config.stopThresh}
              onChange={(e) =>
                onUpdateShared(
                  "stopThresh",
                  Math.max(parseFloat(e.target.value), config.entryThresh + 0.1),
                )
              }
              className="w-full accent-primary"
            />
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Capital USD mn
            </label>
            <input
              type="number"
              min={0.1}
              step={0.1}
              value={config.capitalPerPair}
              onChange={(e) => onUpdateShared("capitalPerPair", parseFloat(e.target.value) || 1)}
              className="w-full rounded border border-border/40 bg-background px-2 py-1.5 font-mono text-[11px] outline-none focus:border-primary/60"
            />
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Costo transacción %
            </label>
            <input
              type="number"
              min={0}
              step={0.05}
              value={config.txCost}
              onChange={(e) => onUpdateShared("txCost", parseFloat(e.target.value) || 0)}
              className="w-full rounded border border-border/40 bg-background px-2 py-1.5 font-mono text-[11px] outline-none focus:border-primary/60"
            />
          </div>
        </div>

        {/* ─── Labadie: Algoritmo de ejecución, p-variance e impacto de mercado ─── */}
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Algoritmo
              <InfoTip>
                Labadie §2.3-2.4: "pairs" usa Z-score clásico; "tc" = Target Close (forward);
                "is" = Implementation Shortfall (backward). TC/IS requieren σ y γ.
              </InfoTip>
            </label>
            <select
              value={config.executionAlgo ?? "pairs"}
              onChange={(e) =>
                onUpdateShared("executionAlgo", e.target.value as "pairs" | "tc" | "is")
              }
              className="w-full rounded border border-border/40 bg-background px-2 py-1.5 font-mono text-[11px] outline-none focus:border-primary/60"
            >
              <option value="pairs">Pairs (Z-score)</option>
              <option value="tc">Target Close</option>
              <option value="is">Implementation Shortfall</option>
            </select>
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              p-value (riesgo): {config.pValue?.toFixed(1) ?? "2.0"}
              <InfoTip>
                Labadie §3.2: p para p-variance. p=2 → varianza clásica; p≠2 → riesgo generalizado.
                Identidad: p = 1/H (H = Hurst exponent).
              </InfoTip>
            </label>
            <input
              type="range"
              min={1.1}
              max={4}
              step={0.1}
              value={config.pValue ?? 2}
              onChange={(e) => onUpdateShared("pValue", parseFloat(e.target.value))}
              className="w-full accent-primary"
            />
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Impacto γ: {config.marketImpactGamma?.toFixed(2) ?? "0.50"}
              <InfoTip>
                Labadie §2.1: γ es el exponente de impacto de mercado. Típico 0.3-0.7.
                I(v) = σ × |v/V|^γ × τ^(1/p). Mayor γ = más impacto por unidad de volumen.
              </InfoTip>
            </label>
            <input
              type="range"
              min={0.1}
              max={1}
              step={0.05}
              value={config.marketImpactGamma ?? 0.5}
              onChange={(e) => onUpdateShared("marketImpactGamma", parseFloat(e.target.value))}
              className="w-full accent-primary"
            />
          </div>
          <div className="space-y-1">
            <label className="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
              Participación: {((config.participationRate ?? 0.1) * 100).toFixed(0)}%
              <InfoTip>
                Labadie §2.2 (PVol): % del volumen total que se ejecuta por intervalo.
                v_n ≤ PVol_max. Default 10%. Menor % = menor impacto pero más lento.
              </InfoTip>
            </label>
            <input
              type="range"
              min={1}
              max={50}
              step={1}
              value={(config.participationRate ?? 0.1) * 100}
              onChange={(e) => onUpdateShared("participationRate", parseFloat(e.target.value) / 100)}
              className="w-full accent-primary"
            />
          </div>
        </div>

        <div className="flex items-center justify-between gap-2">
          <div className="flex items-center gap-2">
            <div className="flex gap-1 rounded-lg border border-border/40 p-0.5">
              <button
                onClick={() => onSourceChange("yahoo")}
                className={`rounded px-2 py-0.5 font-mono text-[10px] transition-colors ${source === "yahoo" ? "bg-primary/10 text-foreground" : "text-muted-foreground hover:text-foreground"}`}
              >
                Yahoo Finance
              </button>
              <button
                onClick={() => onSourceChange("iol")}
                disabled={!accessToken}
                title={
                  accessToken
                    ? undefined
                    : "Inicia sesión en IOL (panel superior) para habilitar esta fuente"
                }
                className={`rounded px-2 py-0.5 font-mono text-[10px] transition-colors ${source === "iol" ? "bg-primary/10 text-foreground" : "text-muted-foreground hover:text-foreground"} ${accessToken ? "" : "opacity-40 cursor-not-allowed"}`}
              >
                IOL{!accessToken ? " · sin sesión" : ""}
              </button>
              {source === "iol" && (
                <select
                  value={iolMercado}
                  onChange={(e) => onIolMercadoChange(e.target.value)}
                  className="ml-1 rounded border border-border/40 bg-background px-1.5 py-0.5 text-[10px] font-mono outline-none"
                >
                  <option value="BCBA">BCBA</option>
                  <option value="NYSE">NYSE</option>
                  <option value="NASDAQ">NASDAQ</option>
                  <option value="ROFEX">ROFEX</option>
                </select>
              )}
            </div>
            <button
              onClick={() => setValidateOOS((v) => !v)}
              className={`rounded border px-2 py-1 font-mono text-[10px] transition-colors ${validateOOS ? "border-accent/60 bg-accent/10 text-foreground" : "border-border/40 text-muted-foreground hover:text-foreground"}`}
            >
              {validateOOS ? "✓ Validar out-of-sample" : "Validar out-of-sample"}
            </button>
          </div>
          <button
            onClick={() => m.mutate()}
            disabled={m.isPending}
            className="rounded bg-primary px-4 py-2 font-mono text-xs font-medium text-primary-foreground transition-colors hover:bg-primary/90 disabled:opacity-50"
          >
            {m.isPending ? "Analizando par..." : `Analizar ${config.asset1} / ${config.asset2}`}
          </button>
        </div>

        {source === "iol" && !accessToken && (
          <div className="rounded-lg border border-warning/40 bg-warning/10 px-4 py-2 font-mono text-[11px] text-warning">
             IOL requiere inicio de sesión — iniciá sesión desde el panel superior
          </div>
        )}

        {error && (
          <div className="rounded-lg border border-danger/40 bg-danger/10 px-4 py-3 font-mono text-[11px] text-danger">
            {error}
          </div>
        )}

        {result && (
          <div className="space-y-5">
            {/* P&L + Performance at top */}
            <div className="grid grid-cols-1 gap-4 lg:grid-cols-2">
              <PnLChart
                data={
                  result.trades.length > 0
                    ? [...result.trades]
                        .sort((a, b) => a.exitDate.localeCompare(b.exitDate))
                        .map((t) => ({ date: t.exitDate, pnl: t.pnlCum }))
                    : [{ date: "", pnl: 0 }]
                }
              />
              <div className="space-y-3 rounded-lg border border-border/40 bg-muted/5 p-4">
                <h3 className="font-mono text-xs font-medium text-foreground">
                  Resumen de Performance
                </h3>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      Total trades
                    </span>
                    <p className="font-mono text-xs text-foreground">
                      {result.performance.totalTrades}
                    </p>
                  </div>
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      Win rate
                      <InfoTip>
                        Porcentaje de trades ganadores. Un win rate &gt; 50% indica más aciertos que
                        errores, pero no garantiza rentabilidad si las pérdidas son mayores que las
                        ganancias.
                      </InfoTip>
                    </span>
                    <p className="font-mono text-xs text-foreground">
                      {result.performance.winRate.toFixed(1)}%
                    </p>
                  </div>
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">PNL total</span>
                    <p
                      className={`font-mono text-xs ${result.performance.totalPnl >= 0 ? "text-success" : "text-danger"}`}
                    >
                      {result.performance.totalPnl >= 0 ? "+" : ""}
                      {result.performance.totalPnl.toFixed(2)}%
                    </p>
                  </div>
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      Max drawdown
                      <InfoTip>
                        Máxima caída desde un pico hasta un valle. Representa el peor escenario
                        histórico. Un drawdown &gt; 20% se considera alto riesgo.
                      </InfoTip>
                    </span>
                    <p className="font-mono text-xs text-danger">
                      {result.performance.maxDrawdown.toFixed(2)}%
                    </p>
                  </div>
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      Sharpe ratio
                      <InfoTip>
                        Mide el retorno ajustado por riesgo. Un Sharpe &gt; 1 se considera bueno,
                        &gt; 2 excelente. Se calcula como (retorno promedio - tasa libre de riesgo)
                        / desviación estándar de los retornos.
                      </InfoTip>
                    </span>
                    <p className="font-mono text-xs text-foreground">
                      {result.performance.sharpe.toFixed(2)}
                    </p>
                  </div>
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      Avg duración
                    </span>
                    <p className="font-mono text-xs text-foreground">
                      {result.performance.avgDuration.toFixed(1)}d
                    </p>
                  </div>
                </div>
              </div>
            </div>

            {/* Cointegration metrics card */}
            <div className="grid grid-cols-2 gap-3 rounded-lg border border-border/40 bg-muted/5 p-4 sm:grid-cols-3 lg:grid-cols-5">
              <div>
                <span className="font-mono text-[10px] text-muted-foreground">
                  Correlación
                  <InfoTip>
                    Mide la relación lineal entre los dos activos, de -1 a +1. Valores &gt; 0.7
                    indican alta correlación positiva. Es condición necesaria pero no suficiente
                    para cointegración.
                  </InfoTip>
                </span>
                <p className="font-mono text-xs text-foreground">{result.correlation.toFixed(4)}</p>
              </div>
              <div>
                <span className="font-mono text-[10px] text-muted-foreground">
                  Beta (slope)
                  <InfoTip>
                    Pendiente de la regresión lineal entre activos. Indica cuánto se mueve activo 2
                    por cada unidad de activo 1. Se usa para construir el spread como: activo1 -
                    beta × activo2.
                  </InfoTip>
                </span>
                <p className="font-mono text-xs text-foreground">{result.beta.toFixed(4)}</p>
              </div>
              <div>
                <span className="font-mono text-[10px] text-muted-foreground">
                  R²
                  <InfoTip>
                    Coeficiente de determinación. Indica qué porcentaje de la variación de un activo
                    es explicado por el otro. Valores &gt; 0.5 indican buena relación lineal.
                  </InfoTip>
                </span>
                <p className="font-mono text-xs text-foreground">{result.r2.toFixed(4)}</p>
              </div>
              <div>
                <span className="font-mono text-[10px] text-muted-foreground">ADF p-value</span>
                <p className="font-mono text-xs text-foreground">{result.adfPValue.toFixed(4)}</p>
              </div>
              <div>
                <span className="font-mono text-[10px] text-muted-foreground">¿Cointegrado?</span>
                <p
                  className={`font-mono text-xs ${result.isCointegrated ? "text-success" : "text-danger"}`}
                >
                  {result.isCointegrated ? " Sí (p < 0.05)" : " No"}
                </p>
              </div>
            </div>

            {/* ─── Labadie §3.2: Hurst, impliedP, p-Sharpe ─── */}
            {(result.hurstExponent !== undefined || result.performance.pSharpe !== undefined || result.impliedP !== undefined) && (
              <div className="grid grid-cols-2 gap-3 rounded-lg border border-border/40 bg-muted/5 p-4 sm:grid-cols-4">
                {result.hurstExponent !== undefined && (
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      Hurst (H)
                      <InfoTip>Labadie §3.2: H=0.5 → random walk; H&lt;0.5 → mean-reverting; H&gt;0.5 → trending. Estima memoria del spread.</InfoTip>
                    </span>
                    <p className="font-mono text-xs text-foreground">{result.hurstExponent.toFixed(3)}</p>
                  </div>
                )}
                {result.impliedP !== undefined && (
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      p = 1/H
                      <InfoTip>Labadie §3.2: Identidad p = 1/H. p=2 → martingala; p≠2 → proceso con memoria.</InfoTip>
                    </span>
                    <p className="font-mono text-xs text-foreground">{result.impliedP.toFixed(2)}</p>
                  </div>
                )}
                {result.impliedPRegression !== undefined && (
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      p (regresión)
                      <InfoTip>Labadie §4 eq.21: p ≈ 2.35 + 0.14×MI − 1.79×σ. Estima p desde volatilidad e impacto de mercado.</InfoTip>
                    </span>
                    <p className="font-mono text-xs text-foreground">{result.impliedPRegression.toFixed(2)}</p>
                  </div>
                )}
                {result.impliedPFromReturns !== undefined && (
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      p (multiescala)
                      <InfoTip>Labadie §4.3: p estimado por regresión log-log de momentos absolutos en múltiples escalas temporales. Más robusto que R/S.</InfoTip>
                    </span>
                    <p className="font-mono text-xs text-foreground">{result.impliedPFromReturns.toFixed(2)}</p>
                  </div>
                )}
                {result.performance.pSharpe !== undefined && (
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      p-Sharpe
                      <InfoTip>Labadie §3.2: Sharpe usando p-variance como risk measure. Si p≠2 captura memoria del proceso.</InfoTip>
                    </span>
                    <p className="font-mono text-xs text-foreground">{result.performance.pSharpe.toFixed(2)}</p>
                  </div>
                )}
                {result.pVarianceUsed !== undefined && (
                  <div>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      p-Variance (E[|r|^p])
                    </span>
                    <p className="font-mono text-xs text-foreground">{result.pVarianceUsed.toFixed(4)}</p>
                  </div>
                )}
              </div>
            )}

            {/* ─── Labadie §2.3-2.4: Trading curve (TC/IS) ─── */}
            {result.tradingCurve && result.tradingCurve.length > 0 && (
              <div className="rounded-lg border border-border/40 p-4">
                <h3 className="mb-2 font-mono text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                  Curva de Ejecución Óptima — {config.executionAlgo === "tc" ? "Target Close" : "Implementation Shortfall"}
                  <InfoTip>
                    Labadie §2.3-2.4: Distribución de volumen óptima por paso temporal.
                    TC (forward) concentra volumen hacia el final; IS (backward) al inicio.
                    {result.optimalStartPct !== undefined && ` Inicio óptimo: ${(result.optimalStartPct * 100).toFixed(0)}%`}
                    {result.optimalStopPct !== undefined && ` Stop óptimo: ${(result.optimalStopPct * 100).toFixed(0)}%`}
                  </InfoTip>
                </h3>
                <div className="h-24">
                  <ResponsiveContainer width="100%" height="100%">
                    <LineChart data={result.tradingCurve} margin={{ top: 4, right: 4, bottom: 0, left: 0 }}>
                      <CartesianGrid stroke="var(--color-border)" vertical={false} strokeDasharray="3 3" />
                      <XAxis dataKey="step" tick={{ fill: "var(--color-muted-foreground)", fontSize: 9, fontFamily: "monospace" }} />
                      <YAxis tick={{ fill: "var(--color-muted-foreground)", fontSize: 9, fontFamily: "monospace" }} width={35} />
                      <Tooltip contentStyle={{ fontSize: 10, fontFamily: "monospace" }} />
                      <Line type="monotone" dataKey="volume" stroke="var(--color-primary)" strokeWidth={1.5} dot={false} name="Vol. por paso" />
                      <Line type="monotone" dataKey="cumulative" stroke="var(--color-success)" strokeWidth={1.5} dot={false} name="Acumulado" />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              </div>
            )}

            {/* IS/OOS Performance (Backtesting Stage 3) */}
            {result.inSamplePerformance && result.outOfSamplePerformance && (
              <div className="grid grid-cols-2 gap-3 rounded-lg border border-border/40 bg-muted/5 p-4">
                <div>
                  <h4 className="mb-1 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                    In-Sample (70%) — Sharpe: {result.inSamplePerformance.sharpe.toFixed(2)}
                  </h4>
                  <div className="grid grid-cols-3 gap-2 text-[11px]">
                    <div>
                      <span className="text-muted-foreground">Trades</span>
                      <p className="font-mono">{result.inSamplePerformance.totalTrades}</p>
                    </div>
                    <div>
                      <span className="text-muted-foreground">PNL</span>
                      <p className={`font-mono ${result.inSamplePerformance.totalPnl >= 0 ? "text-success" : "text-danger"}`}>
                        {result.inSamplePerformance.totalPnl >= 0 ? "+" : ""}{result.inSamplePerformance.totalPnl.toFixed(2)}%
                      </p>
                    </div>
                    <div>
                      <span className="text-muted-foreground">Win Rate</span>
                      <p className="font-mono">{result.inSamplePerformance.winRate.toFixed(1)}%</p>
                    </div>
                  </div>
                </div>
                <div>
                  <h4 className="mb-1 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                    Out-of-Sample (30%) — Sharpe: {result.outOfSamplePerformance.sharpe.toFixed(2)}
                  </h4>
                  <div className="grid grid-cols-3 gap-2 text-[11px]">
                    <div>
                      <span className="text-muted-foreground">Trades</span>
                      <p className="font-mono">{result.outOfSamplePerformance.totalTrades}</p>
                    </div>
                    <div>
                      <span className="text-muted-foreground">PNL</span>
                      <p className={`font-mono ${result.outOfSamplePerformance.totalPnl >= 0 ? "text-success" : "text-danger"}`}>
                        {result.outOfSamplePerformance.totalPnl >= 0 ? "+" : ""}{result.outOfSamplePerformance.totalPnl.toFixed(2)}%
                      </p>
                    </div>
                    <div>
                      <span className="text-muted-foreground">Win Rate</span>
                      <p className="font-mono">{result.outOfSamplePerformance.winRate.toFixed(1)}%</p>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* Current signal */}
            {result.zScore.length > 0 &&
              (() => {
                const lastZ = result.zScore[result.zScore.length - 1].value;
                const absZ = Math.abs(lastZ);
                const isSignal = absZ >= config.entryThresh;
                const isStop = absZ >= config.stopThresh;
                const direction = lastZ > 0 ? "SHORT" : "LONG";
                let signalColor: string;
                let signalLabel: string;
                if (isStop) {
                  signalColor = "bg-red-500/20 border-red-500/40 text-red-400";
                  signalLabel = `${direction} (STOP-LOSS)`;
                } else if (isSignal) {
                  signalColor = "bg-yellow-500/15 border-yellow-500/30 text-yellow-300";
                  signalLabel = `${direction}`;
                } else {
                  signalColor = "bg-muted/10 border-border/30 text-muted-foreground";
                  signalLabel = "NEUTRAL";
                }
                return (
                  <div className={`rounded-lg border p-3 ${signalColor}`}>
                    <div className="flex items-center justify-between">
                      <div>
                        <span className="font-mono text-[10px] uppercase tracking-wider opacity-70">
                          Señal Actual
                        </span>
                        <p className="font-mono text-sm font-bold mt-0.5">{signalLabel}</p>
                      </div>
                      <div className="text-right">
                        <span className="font-mono text-[10px] opacity-70">Z-Score</span>
                        <p className="font-mono text-sm font-bold">{lastZ.toFixed(2)}σ</p>
                      </div>
                      <div className="text-right">
                        <span className="font-mono text-[10px] opacity-70">Umbral</span>
                        <p className="font-mono text-sm">
                          {config.entryThresh.toFixed(1)}σ / {config.stopThresh.toFixed(1)}σ
                        </p>
                      </div>
                    </div>
                    <div className="flex items-center gap-2 mt-1">
                      <p className="font-mono text-[10px] opacity-60">
                        {isStop
                          ? ` Z-Score en zona de stop-loss. Considerar cerrar posición.`
                          : isSignal
                            ? `${direction === "SHORT" ? "Vender" : "Comprar"} ${result.asset1}, ${direction === "SHORT" ? "Comprar" : "Vender"} ${result.asset2} (pairs trade).`
                            : `Esperar que Z-Score cruce ±${config.entryThresh}σ para entrar.`}
                      </p>
                      {result.correlationBreakdown?.isBreaking && (
                        <span className="shrink-0 rounded border border-warning/40 bg-warning/10 px-1.5 py-0.5 text-[9px] text-warning font-mono">
                           Correlación debilitándose ({result.correlationBreakdown.current.toFixed(2)} vs hist. {result.correlationBreakdown.historical.toFixed(2)})
                        </span>
                      )}
                    </div>
                  </div>  
                );
              })()}

            {/* Normalized prices */}
            <div className="space-y-2">
              <h3 className="font-mono text-xs font-medium text-foreground">
                Precio Normalizado (Base 100)
              </h3>
              <div className="rounded-lg border border-border/40 bg-background/40/40 p-3">
                <ResponsiveContainer width="100%" height={200}>
                  <LineChart
                    data={result.normalizedPrices}
                    margin={{ top: 6, right: 8, bottom: 4, left: 0 }}
                  >
                    <CartesianGrid stroke="rgba(255,255,255,0.04)" vertical={false} />
                    <XAxis
                      dataKey="date"
                      tick={{ fontSize: 8, fontFamily: "monospace", fill: "#9aa6bd" }}
                      stroke="#2b3242"
                      axisLine={false}
                      tickLine={false}
                      interval="preserveStartEnd"
                      tickFormatter={fmtDate}
                    />
                    <YAxis
                      tick={{ fontSize: 9, fontFamily: "monospace", fill: "#9aa6bd" }}
                      stroke="#2b3242"
                      axisLine={false}
                      tickLine={false}
                      width={40}
                    />
                    <Tooltip
                      contentStyle={{
                        background: "#141a28",
                        border: "1px solid #2b3242",
                        borderRadius: 8,
                        fontSize: 11,
                        fontFamily: "monospace",
                      }}
                      labelFormatter={fmtDate}
                    />
                    {selectedTrade && (
                      <ReferenceLine
                        x={selectedTrade.entryDate}
                        stroke="#fbbf24"
                        strokeDasharray="4 4"
                        strokeWidth={1.5}
                      />
                    )}
                    {selectedTrade && (
                      <ReferenceLine
                        x={selectedTrade.exitDate}
                        stroke="#f97316"
                        strokeDasharray="4 4"
                        strokeWidth={1.5}
                      />
                    )}
                    <Line
                      type="monotone"
                      dataKey="a1"
                      stroke="#3b82f6"
                      dot={false}
                      strokeWidth={1.5}
                      name={result.asset1}
                    />
                    <Line
                      type="monotone"
                      dataKey="a2"
                      stroke="#a855f7"
                      dot={false}
                      strokeWidth={1.5}
                      name={result.asset2}
                    />
                  </LineChart>
                </ResponsiveContainer>
              </div>
            </div>

            <TradingViewCompareWidget asset1={result.asset1} asset2={result.asset2} height={520} />

            <div className="grid grid-cols-1 gap-4 lg:grid-cols-2">
              <SpreadChart
                data={result.spread}
                signals={result.signals}
                selectedEntry={selectedTrade?.entryDate}
                selectedExit={selectedTrade?.exitDate}
                splitDate={result.splitDate}
              />
              <ZScoreChart
                data={result.zScore}
                signals={result.signals}
                entryThresh={config.entryThresh}
                stopThresh={config.stopThresh}
                selectedEntry={selectedTrade?.entryDate}
                selectedExit={selectedTrade?.exitDate}
                splitDate={result.splitDate}
              />
            </div>

            <TradesTable
              trades={result.trades}
              txCost={config.txCost}
              asset1={result.asset1}
              asset2={result.asset2}
              selectedIdx={selectedTradeIdx}
              onSelectTrade={(idx) =>
                setSelectedTradeIdx(selectedTradeIdx === idx ? undefined : idx)
              }
            />

            {/* ─── TAO-* + PAIDF-* + Physical-AI-*: Social Content ─── */}
            {(() => {
              const socialInput: InvestorContentInput = {
                strategyName: `${result.asset1} / ${result.asset2}`,
                annualReturn: (result.performance.totalPnl || 0) / 100,
                annualVol: 0,
                sharpe: result.performance.sharpe || 0,
                pValue: result.pVarianceUsed ?? 2,
                impliedP: result.impliedP,
                impliedPRegression: result.impliedPRegression,
                topAllocations: [
                  { ticker: result.asset1, weight: 0.5 },
                  { ticker: result.asset2, weight: 0.5 },
                ],
              };
              const anomalyReport = detectCalculationAnomalies({
                returns: result.spread.map(s => s.value),
                pValue: result.pVarianceUsed ?? 2,
                sharpe: result.performance.sharpe || 0,
                volatility: 0,
                meanReturn: 0,
              });
              return (
                <SocialContentPanel input={socialInput} anomalyReport={anomalyReport} />
              );
            })()}
          </div>
        )}
      </div>
    </TooltipProvider>
  );
}
