// ─── Tipos ─────────────────────────────────────────────────────

export interface EvaluacionCapa {
  nombre: string;
  disponible: boolean;
  valor: number | null;
  detalle: string;
  umbralUsado: string | null;
}

export interface RecomendacionActivo {
