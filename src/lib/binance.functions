import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { binanceSignedGet } from "./binance-auth";
import type { BinanceAccountInfo, BinanceOrder, BinanceTrade } from "./binance-auth";

export const fetchBinanceAccount = createServerFn({ method: "POST" }).handler(
  async (): Promise<BinanceAccountInfo> => {
    return binanceSignedGet<BinanceAccountInfo>("/api/v3/account");
  },
);

export const fetchBinanceBalances = createServerFn({ method: "POST" }).handler(
  async (): Promise<{ asset: string; free: string; locked: string }[]> => {
    const account = await binanceSignedGet<BinanceAccountInfo>("/api/v3/account");
    return account.balances.filter((b) => parseFloat(b.free) > 0 || parseFloat(b.locked) > 0);
  },
);

export const fetchBinanceOpenOrders = createServerFn({ method: "POST" })
  .inputValidator((input: unknown) => z.object({ symbol: z.string().optional() }).parse(input))
  .handler(async ({ data }): Promise<BinanceOrder[]> => {
    const params: Record<string, string | number> = {};
    if (data.symbol) params.symbol = data.symbol.toUpperCase();
    return binanceSignedGet<BinanceOrder[]>("/api/v3/openOrders", params);
  });

export const fetchBinanceTrades = createServerFn({ method: "POST" })
  .inputValidator((input: unknown) =>
    z
      .object({
        symbol: z.string().min(1).max(20),
        limit: z.number().default(20),
      })
      .parse(input),
  )
  .handler(async ({ data }): Promise<BinanceTrade[]> => {
    const params: Record<string, string | number> = {
      symbol: data.symbol.toUpperCase(),
      limit: data.limit,
    };
    return binanceSignedGet<BinanceTrade[]>("/api/v3/myTrades", params);
  });
