import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { RangoHistorico } from "./market-data.types";
import { getCached, setCache } from "./cache";
import { getBacktestSenalesTecnicas } from "./backtest-senales-tecnicas.functions";
import { getBacktestSenalesFundamentales } from "./backtest-senales-fundamentales.functions";
import { detectarSenalesCruzadas, VENTANA_DEFAULT_DIAS } from "./senales-cruzadas";
import type { DireccionCruzada } from "./senales-cruzadas";

const CACHE_TTL = 24 * 60 * 60 * 1000;

export interface ResultadoCruzado {
  fechaConfirmacion: string;
  direccion: DireccionCruzada;
  senalSemaforo: string;
  senalFundamental: string;
  diasEntreSenales: number;
  precioEntrada: number;
  retorno5d: number | null;
  retorno20d: number | null;
  retorno60d: number | null;
}

export interface ResumenComparativo {
  tipo: "solo_tecnica" | "solo_fundamental" | "cruzada_alcista" | "cruzada_bajista";
  ocurrencias: number;
  winRate20d: number;
  retornoPromedio20d: number;
  equityCurve: { fecha: string; valor: number }[];
}

export interface BacktestCruzadoResult {
  ticker: string;
  periodo: string;
  totalCruzadas: number;
  resumenComparativo: ResumenComparativo[];
  detalle: ResultadoCruzado[];
  cacheKey: string;
  error?: string;
}

export const getBacktestSenalesCruzadas = createServerFn({ method: "POST" })
  .validator((input: unknown) =>
    z.object({
      ticker: z.string().min(1).max(20),
      rango: z.enum(["1Y", "3Y", "5Y", "MAX"]).default("3Y"),
      ventanaDias: z.number().min(1).max(60).default(VENTANA_DEFAULT_DIAS),
    }).parse(input),
  )
  .handler(async ({ data }): Promise<BacktestCruzadoResult> => {
    const { ticker, rango, ventanaDias } = data;
    const cacheKey = `btc_${ticker}_${rango}_w${ventanaDias}`;

    const cached = getCached<BacktestCruzadoResult>(cacheKey, CACHE_TTL);
    if (cached) return cached;

    // Reutilizar resultados ya calculados
    const [tecRes, fundRes] = await Promise.all([
      getBacktestSenalesTecnicas({ data: { ticker, rango } }).catch(() => null),
      getBacktestSenalesFundamentales({ data: { ticker, rango } }).catch(() => null),
    ]);

    if (!tecRes || tecRes.error) {
      return { ticker, periodo: rango, totalCruzadas: 0, resumenComparativo: [], detalle: [], cacheKey, error: tecRes?.error ?? "Error en backtest técnico" };
    }

    // Reconstruir señales desde el detalle para cruzarlas
    const senalesSemaforo: import("./senales-tecnicas").SenalSemaforo[] = tecRes.detalle.map((d) => ({
      fecha: d.fecha,
      precio: d.precioEntrada,
      scoreAnterior: d.scoreAnterior,
      scoreActual: d.scoreActual,
      clasificacionAnterior: d.clasificacionAnterior,
      clasificacionActual: d.clasificacionActual,
      tipo: d.tipo === "mejora" ? "mejora" : "empeora",
      descripcion: `${d.clasificacionAnterior}→${d.clasificacionActual}`,
    }));

    const senalesFundamentales: import("./senales-fundamentales").SenalFundamental[] = (fundRes?.detalle ?? []).map((d) => ({
      tipo: d.tipo as import("./senales-fundamentales").TipoSenalFundamental,
      fechaPublicacion: d.fechaPublicacion,
      precioCierre: d.precioEntrada,
      valorIndicador: d.valorIndicador,
      descripcion: d.descripcion,
    }));

    if (senalesFundamentales.length === 0) {
      return { ticker, periodo: rango, totalCruzadas: 0, resumenComparativo: [], detalle: [], cacheKey, error: "Sin señales fundamentales para cruzar" };
    }

    const cruzadas = detectarSenalesCruzadas(senalesSemaforo, senalesFundamentales, ventanaDias);

    // Calcular retornos forward para cada cruzada
    const detalle: ResultadoCruzado[] = [];
    for (const c of cruzadas) {
      const idx = tecRes.detalle.findIndex((d) => d.fecha === c.fechaConfirmacion);
      if (idx === -1) continue;

      const getRet = (offset: number): number | null => {
        const targetIdx = idx + offset;
        if (targetIdx >= tecRes.detalle.length) return null;
        const p = tecRes.detalle[targetIdx].precioEntrada;
        return p > 0 ? p / c.precioConfirmacion - 1 : null;
      };

      detalle.push({
        fechaConfirmacion: c.fechaConfirmacion,
        direccion: c.direccion,
        senalSemaforo: c.descripcion.split("+")[0]?.trim() ?? "",
        senalFundamental: c.senalFundamental.tipo,
        diasEntreSenales: c.diasEntreSenales,
        precioEntrada: c.precioConfirmacion,
        retorno5d: getRet(5),
        retorno20d: getRet(20),
        retorno60d: getRet(60),
      });
    }

    // Resumen comparativo
    const resumenComparativo: ResumenComparativo[] = [];
    const alcistas = detalle.filter((d) => d.direccion === "alcista");
    const bajistas = detalle.filter((d) => d.direccion === "bajista");

    const buildResumen = (items: ResultadoCruzado[], tipo: ResumenComparativo["tipo"]): ResumenComparativo | null => {
      const ret20s = items.map((i) => i.retorno20d).filter((r): r is number => r != null);
      if (ret20s.length < 2) return null;
      const wins = ret20s.filter((r) => r > 0).length;
      let valor = 1;
      const equityCurve: { fecha: string; valor: number }[] = [];
      for (const item of items.sort((a, b) => a.fechaConfirmacion.localeCompare(b.fechaConfirmacion))) {
        if (item.retorno20d != null) { valor *= (1 + item.retorno20d); equityCurve.push({ fecha: item.fechaConfirmacion, valor }); }
      }
      return { tipo, ocurrencias: ret20s.length, winRate20d: (wins / ret20s.length) * 100, retornoPromedio20d: ret20s.reduce((s, r) => s + r, 0) / ret20s.length, equityCurve };
    };

    // También extraer métricas de las señales no-cruzadas para comparar
    const soloTecnica = tecRes.resumen.find((r) => r.tipo === "total");
    if (soloTecnica) {
      resumenComparativo.push({ tipo: "solo_tecnica", ocurrencias: soloTecnica.ocurrencias, winRate20d: soloTecnica.winRate20d, retornoPromedio20d: soloTecnica.retornoPromedio20d, equityCurve: soloTecnica.equityCurve });
    }
    if (fundRes?.porTipo) {
      const totalFund = fundRes.porTipo.reduce((s, t) => s + t.ocurrencias, 0);
      const winsFund = fundRes.porTipo.reduce((s, t) => s + t.ocurrencias * t.winRate20d / 100, 0);
      if (totalFund > 0) {
        resumenComparativo.push({
          tipo: "solo_fundamental",
          ocurrencias: totalFund,
          winRate20d: (winsFund / totalFund) * 100,
          retornoPromedio20d: fundRes.porTipo.reduce((s, t) => s + t.retornoPromedio20d * t.ocurrencias, 0) / totalFund,
          equityCurve: [],
        });
      }
    }

    const rAlcista = buildResumen(alcistas, "cruzada_alcista");
    const rBajista = buildResumen(bajistas, "cruzada_bajista");
    if (rAlcista) resumenComparativo.push(rAlcista);
    if (rBajista) resumenComparativo.push(rBajista);

    const result: BacktestCruzadoResult = {
      ticker, periodo: rango,
      totalCruzadas: detalle.length,
      resumenComparativo, detalle, cacheKey,
    };

    setCache(cacheKey, result);
    return result;
  });
